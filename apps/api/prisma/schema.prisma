generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  plan      String   @default("free")
  ownerId   String
  createdAt DateTime @default(now())
  members       WorkspaceMember[]
  spaces        Space[]
  aiChats       AiChat[]
  notifications Notification[]
  dailyBriefs   DailyBrief[]
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?
  createdAt    DateTime @default(now())

  memberships        WorkspaceMember[]
  assignedTasks      Task[]            @relation("TaskAssigneeUser")
  createdTasks       Task[]            @relation("TaskCreatedBy")
  reviewedTasks      Task[]            @relation("TaskReviewer")
  taskAssigneeLinks  TaskAssignee[]
  aiChats            AiChat[]
  notifications           Notification[]
  actedNotifications      Notification[]         @relation("NotificationActor")
  notificationPreference  NotificationPreference?
  dailyBriefs             DailyBrief[]
  sentEmails              TaskEmail[]
}

model WorkspaceMember {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String
  role        String   // owner, admin, member, guest
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model Space {
  id           String   @id @default(uuid())
  workspaceId String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  settings     Json?
  folders      Folder[]
  lists        List[]
  statuses     Status[]
  customFields CustomField[]
  automations  Automation[]
}

model Folder {
  id      String @id @default(uuid())
  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name    String
  lists   List[]
}

model List {
  id       String  @id @default(uuid())
  spaceId  String
  space    Space   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  folderId String?
  folder   Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  name     String
  tasks    Task[]
}

model Task {
  id           String    @id @default(uuid())
  listId       String
  list         List      @relation(fields: [listId], references: [id], onDelete: Cascade)
  parentTaskId String?
  title        String
  description  String?
  statusId     String
  priority     String?
  dueDate      DateTime?
  startDate    DateTime?
  progressDate DateTime?
  position     Float
  customFields Json?
  assigneeId   String?
  assignee     User?     @relation("TaskAssigneeUser", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById  String?
  createdBy    User?     @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  assigneeName String?
  ownerName    String?
  workCategory String?
  scope        String?
  url          String?
  code         String?   @unique
  taskType     String?
  team         String?
  reviewerId   String?
  reviewer     User?     @relation("TaskReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  estimatedTime String?
  actualTime   String?
  dependencyType String?
  dependencyTaskId String?
  dependencyTask   Task?  @relation("TaskDependency", fields: [dependencyTaskId], references: [id], onDelete: SetNull)
  dependents       Task[] @relation("TaskDependency")
  acceptanceCriteria String?
  approvalStatus String @default("Not Required")
  createdAt    DateTime  @default(now())

  assignees    TaskAssignee[]
  comments     Comment[]
  attachments  Attachment[]
  checklists   Checklist[]
  timeEntries  TimeEntry[]
  nextActions  NextActionEntry[]

  subtasks      Task[]         @relation("TaskSubtasks")
  parentTask    Task?          @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  notifications Notification[]

  emails TaskEmail[]
}

model NextActionEntry {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())
}

model TaskAssignee {
  id     String @id @default(uuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
}

model Status {
  id      String @id @default(uuid())
  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name    String
  color   String
  order   Int
  type    String // open | in_progress | done
}

model CustomField {
  id      String @id @default(uuid())
  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name    String
  type    String
  config  Json?
}

model Comment {
  id         String   @id @default(uuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId     String
  authorName String?
  body       String
  createdAt  DateTime @default(now())
}

model Attachment {
  id     String @id @default(uuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  url    String
  name   String
}

model Checklist {
  id     String @id @default(uuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  name   String
  items  ChecklistItem[]
}

model ChecklistItem {
  id          String    @id @default(uuid())
  checklistId String
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  text        String
  done        Boolean   @default(false)
}

model TimeEntry {
  id       String    @id @default(uuid())
  taskId   String
  task     Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId   String
  start    DateTime
  end      DateTime?
  duration Int?
}

model Automation {
  id         String @id @default(uuid())
  spaceId    String
  space      Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  trigger    Json
  conditions Json
  actions    Json
}

model ActivityLog {
  id          String   @id @default(uuid())
  workspaceId String
  taskId      String?
  userId      String
  action      String
  meta        Json?
  createdAt   DateTime @default(now())
}

model AiChat {
  id          String      @id @default(uuid())
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String      @default("New chat")
  contextJson Json?
  model       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  messages    AiMessage[]

  @@index([workspaceId, userId, updatedAt])
}

model AiMessage {
  id           String   @id @default(uuid())
  chatId       String
  chat         AiChat   @relation(fields: [chatId], references: [id], onDelete: Cascade)
  role         String
  content      String
  contextJson  Json?
  toolCalls    Json?
  responseJson Json?
  createdAt    DateTime @default(now())

  @@index([chatId, createdAt])
}

model Notification {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  taskId      String?
  task        Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  type        String
  title       String
  message     String
  isRead      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  readAt      DateTime?
  actorId     String?
  actor       User?     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  eventKey    String?   @unique

  @@index([userId, isRead, createdAt])
  @@index([userId, workspaceId, createdAt])
  @@index([userId, workspaceId, type, createdAt])
}

model NotificationPreference {
  id                   String   @id @default(uuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskAssigned         Boolean  @default(true)
  taskReassigned       Boolean  @default(true)
  taskStatusChanged    Boolean  @default(true)
  taskPriorityChanged  Boolean  @default(true)
  taskCompleted        Boolean  @default(true)
  taskReopened         Boolean  @default(true)
  taskDueToday         Boolean  @default(true)
  taskDueTomorrow      Boolean  @default(true)
  taskOverdue          Boolean  @default(true)
  taskComment          Boolean  @default(true)
  taskMention          Boolean  @default(true)
  workspaceActivity    Boolean  @default(true)
  dailyAiBrief         Boolean  @default(false)
  dailyDigest          Boolean  @default(false)
  emailTaskAssigned    Boolean  @default(true)
  emailTaskReassigned  Boolean  @default(true)
  emailTaskDueToday    Boolean  @default(true)
  emailTaskDueTomorrow Boolean  @default(true)
  emailTaskOverdue     Boolean  @default(true)
  emailTaskComment     Boolean  @default(true)
  emailTaskMention     Boolean  @default(true)
  emailTaskStatusChanged Boolean @default(true)
  emailTaskPriorityChanged Boolean @default(true)
  emailDailySummary    Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model DailyBrief {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  briefDate   String
  content     String
  generatedAt DateTime  @default(now())

  @@unique([userId, workspaceId, briefDate])
  @@index([userId, workspaceId, briefDate])
}

model TaskEmail {
  id              String    @id @default(uuid())
  taskId          String?
  task            Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  workspaceId     String
  senderId        String
  sender          User      @relation(fields: [senderId], references: [id], onDelete: Cascade)
  recipientEmail  String
  cc              String?
  subject         String
  body            String
  status          String    @default("pending")
  messageId       String?
  error           String?
  kind            String    @default("manual")
  notificationType String?
  sentAt          DateTime?
  createdAt       DateTime  @default(now())

  @@index([taskId, createdAt])
  @@index([senderId, kind, createdAt])
}
